# Copy this file to .env and fill in your key. Never commit .env.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Search, saving, and uploading work without it; summaries and Q&A need it.
GEMINI_API_KEY=

# Gemini model for upload metadata, summaries, and Q&A. If you keep hitting the
# free-tier quota, try another free model, for example gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# Folder for the SQLite database and saved PDFs (relative to the repo root).
DATA_DIR=data
